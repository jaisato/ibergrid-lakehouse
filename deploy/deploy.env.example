# What the deploy job in .github/workflows/release.yml reads. Nothing here is a file the job
# loads: each value is set in the GitHub repository settings. Until DEPLOY_HOST exists the deploy
# job is skipped, so tagging a release only publishes the image.

# Repository variables (Settings > Secrets and variables > Actions > Variables).
# DEPLOY_HOST must be a repository variable, not an environment one: the job's `if` reads it
# before the production environment is loaded.
DEPLOY_HOST=server.example.com
DEPLOY_USER=deploy

# Secrets of the `production` environment (Settings > Environments > production).
# DEPLOY_SSH_KEY: private key (OpenSSH format) whose public half is in the server's
#   ~DEPLOY_USER/.ssh/authorized_keys; give that user access to Docker and nothing else.
# DEPLOY_KNOWN_HOSTS: the server's host key line(s), from `ssh-keyscan -t ed25519 <host>` checked
#   against the server console; the job refuses unknown host keys.
DEPLOY_SSH_KEY=
DEPLOY_KNOWN_HOSTS=

# On the server, ~DEPLOY_USER/ibergrid-lakehouse/.env holds the runtime values documented in the
# repository's .env.example (R2 endpoint and keys, Lakekeeper secrets, IBERGRID_IMAGE). The job
# copies compose.yaml and compose.prod.yaml next to it and writes IBERGRID_APP_DIGEST on each
# release. If the GHCR package is private, run `docker login ghcr.io` there once with a read-only
# token (read:packages).
