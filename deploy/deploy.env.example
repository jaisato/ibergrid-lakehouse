# What the deploy job in .github/workflows/release.yml reads. Nothing here is a file the job
# loads: each value is set in the GitHub repository settings. Until DEPLOY_HOST exists the deploy
# job is skipped, so tagging a release only publishes the image.

# Repository variables (Settings > Secrets and variables > Actions > Variables).
# DEPLOY_HOST must be a repository variable, not an environment one: the job's `if` reads it
# before the production environment is loaded.
DEPLOY_HOST=server.example.com
DEPLOY_USER=deploy

# Secrets of the `production` environment (Settings > Environments > production).
# DEPLOY_SSH_KEY: private key (OpenSSH format) whose public half is in the server's
#   ~DEPLOY_USER/.ssh/authorized_keys; give that user access to Docker and nothing else.
# DEPLOY_KNOWN_HOSTS: the server's host key line(s), from `ssh-keyscan -t ed25519 <host>` checked
#   against the server console; the job refuses unknown host keys.
DEPLOY_SSH_KEY=
DEPLOY_KNOWN_HOSTS=

# On the server, ~DEPLOY_USER/ibergrid-lakehouse/.env holds the runtime values documented in the
# repository's .env.example (R2 endpoint and keys, the Lakekeeper secrets, DAGSTER_DB_PASSWORD for
# Dagster's Postgres); the deploy never writes it.
# Each release copies compose.yaml and compose.prod.yaml next to it and writes release.env with
# IBERGRID_APP_DIGEST and IBERGRID_ORCHESTRATION_DIGEST. Manual commands on the server use both
# files:
#   docker compose --env-file .env --env-file release.env -f compose.yaml -f compose.prod.yaml ps
# If a GHCR package (ibergrid-lakehouse, ibergrid-lakehouse-orchestration) is private, run
# `docker login ghcr.io` there once with a read-only token (read:packages).
# The Dagster UI publishes no port on the server. The host reaches the webserver at its address on
# the internal orchestration network, so tunnel to it and open http://127.0.0.1:28300:
#   ip=$(ssh DEPLOY_USER@DEPLOY_HOST docker inspect -f \
#     "'{{(index .NetworkSettings.Networks \"ibergrid_orchestration\").IPAddress}}'" \
#     ibergrid-dagster-webserver-1)
#   ssh -N -L 127.0.0.1:28300:"$ip":3000 DEPLOY_USER@DEPLOY_HOST
