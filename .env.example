# The variables of this project: everything the compose files and serving layer read.
# For local development run `make env`, which writes a .env with random values for the required
# secrets; the rest have working defaults.
# The repository is public: .env is git-ignored and must never be committed.

# --- Object storage (S3 API) -------------------------------------------------------------------
# Required. Local: the RustFS root keys (any random strings). Production: the access key ID and
# secret of a Cloudflare R2 API token scoped to the bucket.
# Rotating them: the catalog keeps its own copy of the pair, stored in the warehouse when
# catalog-init created it, and bootstrap never updates an existing warehouse. After changing them
# here, push the new pair to the catalog (it calls POST /management/v1/warehouse/{id}/storage
# with the credential and the warehouse's profile, where only the fields ibergrid owns are reset:
# flavor, endpoint, region, path-style, remote signing; Lakekeeper validates it before saving):
#   local:  make up && docker compose run --rm --no-deps catalog-init catalog update-credential
#   server: docker compose --env-file .env --env-file release.env -f compose.yaml \
#             -f compose.prod.yaml run --rm --no-deps catalog-init catalog update-credential
# The same command turns remote signing off on a warehouse created before ADR 0002 (locally,
# `make down-volumes && make up` recreates the warehouse instead).
IBERGRID_S3_ACCESS_KEY=
IBERGRID_S3_SECRET_KEY=
# Production only (required there): https://<account-id>.r2.cloudflarestorage.com
# Local default: http://storage:9000 (the RustFS container).
#IBERGRID_S3_ENDPOINT_URL=
# Local default us-east-1; production default auto (what R2 expects).
#IBERGRID_S3_REGION=
#IBERGRID_S3_BUCKET=ibergrid

# --- Catalog: Lakekeeper on Postgres -----------------------------------------------------------
# Required. Password of the lakekeeper Postgres role. URL-safe characters only: it is embedded
# in a postgresql:// connection URL.
LAKEKEEPER_DB_PASSWORD=
# Required. Encrypts the storage credentials Lakekeeper keeps in Postgres. Changing or losing it
# makes the stored credentials unreadable, so keep it with the database backups.
LAKEKEEPER_ENCRYPTION_KEY=
# Name of the Iceberg warehouse (also its key prefix inside the bucket).
#IBERGRID_CATALOG_WAREHOUSE=lakehouse

# --- Orchestration: Dagster on Postgres (ADR 0005) ----------------------------------------------
# Required. Password of the dagster Postgres role (run, event and schedule storage). URL-safe
# characters only.
DAGSTER_DB_PASSWORD=
# The schedules (REData daily, OMIE twice a day, the audit-branch sweeper) start stopped, so a
# local stack never calls the sources on its own; production defaults to true. Each can also be
# started in the UI (http://127.0.0.1:28300).
#IBERGRID_ORCHESTRATION_SCHEDULES_RUNNING=false

# --- Broker: Redpanda, SASL/SCRAM (ADR 0006) --------------------------------------------------
# Required. broker-init creates three SCRAM users with these passwords: ibergrid-admin (the
# superuser, used by broker-init only), ibergrid-producer and ibergrid-consumer (each with its
# least-privilege ACLs). Hex or other shell-safe characters.
# An existing deployment (a .env from before phase 2) must add all three lines, with random
# values (for example `od -An -N24 -tx1 /dev/urandom | tr -d ' \n'`), and must not regenerate
# the file: the other secrets open the existing volumes. The next `up` runs broker-init, which
# hardens the running broker in place.
# Rotating: change the producer's or the consumer's password here and run broker-init again
# (`docker compose up -d broker-init`), then restart that service. The admin password cannot be
# changed this way: broker-init authenticates with it (see ADR 0006).
REDPANDA_ADMIN_PASSWORD=
REDPANDA_PRODUCER_PASSWORD=
REDPANDA_CONSUMER_PASSWORD=

# --- Streaming lane (ADR 0006) ---------------------------------------------------------------
# Defaults below; compose passes each to the stream services. The topics and the consumer group
# are fixed in compose.yaml (x-stream-names), once for broker-init and both services.
# Seconds between the producer's REData polls, and how long after local midnight (seconds) it
# still asks for yesterday.
#IBERGRID_STREAM_POLL_INTERVAL=300
#IBERGRID_STREAM_MIDNIGHT_GRACE=7200
# A micro-batch flushes at this many rows or this many seconds after its first; progress without
# rows (duplicates, dead letters) is checkpointed at most every CHECKPOINT_INTERVAL seconds.
#IBERGRID_STREAM_FLUSH_RECORDS=10000
#IBERGRID_STREAM_FLUSH_AGE=60
#IBERGRID_STREAM_CHECKPOINT_INTERVAL=900
# Days of the stream table the duplicate check reads at start; seconds after which a run branch
# is a dead run's (also the sweep's cadence); days of snapshots kept by the daily expiry; seconds
# a loop may go without turning before the watchdog ends the process (restart recovers it).
#IBERGRID_STREAM_DEDUP_DAYS=3
#IBERGRID_STREAM_STALE_BRANCH_AGE=900
#IBERGRID_STREAM_SNAPSHOT_RETENTION_DAYS=3
#IBERGRID_STREAM_WATCHDOG_TIMEOUT=900

# --- Sources: Red Eléctrica REData (public API, no token) ---------------------------------------
# Defaults below. One ingestion process never sends more than one request a second (MAX_RPS is
# capped at 1; the limit is per process, so N parallel processes send up to N a second) and
# retries timeouts, 429 and 5xx a few times; a whole year of national daily generation took 19 s
# to answer, hence the generous timeout (seconds per request).
#IBERGRID_REDATA_BASE_URL=https://apidatos.ree.es
#IBERGRID_REDATA_TIMEOUT=60
#IBERGRID_REDATA_MAX_RPS=1

# --- Sources: OMIE day-ahead market files (public downloads, no token) --------------------------
# Defaults below. One file per delivery day, at most one request a second per process (capped at
# 1), with the same retries as REData; a day's file is about 2.7 KB.
#IBERGRID_OMIE_BASE_URL=https://www.omie.es
#IBERGRID_OMIE_TIMEOUT=30
#IBERGRID_OMIE_MAX_RPS=1

# --- Logging -----------------------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Containers always log JSON.
# --- Transforms (ADR 0007) ---------------------------------------------------------------------
# DuckDB worker threads used by dbt build (1 keeps container memory bounded; max 8).
#IBERGRID_TRANSFORM_THREADS=1

# --- Quality, Maintenance & OpenLineage (ADR 0008) ---------------------------------------------
# Snapshot retention and safety grace window before unreferenced S3 objects can be deleted.
#IBERGRID_MAINTENANCE_SNAPSHOT_RETENTION_DAYS=7
#IBERGRID_MAINTENANCE_RETAIN_LAST_SNAPSHOTS=5
#IBERGRID_MAINTENANCE_ORPHAN_GRACE_HOURS=48
# OpenLineage v2 observability: structlog always emits events; set SINK_PATH for a local JSONL
# log or ENDPOINT_URL (e.g. http://marquez:5000) to push RunEvents to an OpenLineage server.
#IBERGRID_LINEAGE_NAMESPACE=ibergrid
#IBERGRID_LINEAGE_SINK_PATH=
#IBERGRID_LINEAGE_ENDPOINT_URL=

#IBERGRID_LOG_LEVEL=INFO

# --- Serving API & Interactive Portal (ADR 0010) -----------------------------------------------
# Defaults below. Sliding-window per-IP rate limit on /v1/*, CORS allowlist (comma-separated)
# and short in-process DuckDB query cache TTL. In compose.prod.yaml TRUST_PROXY_HEADERS=true so
# rate limiting keys on the rightmost X-Forwarded-For hop added by Caddy.
#IBERGRID_API_RATE_LIMIT_RPM=60
#IBERGRID_API_CORS_ORIGINS=http://127.0.0.1:28000,http://localhost:28000
#IBERGRID_API_CACHE_TTL_SECONDS=60
#IBERGRID_API_TRUST_PROXY_HEADERS=false

# --- Production only (compose.prod.yaml, on the server) ----------------------------------------
# Image repositories on GHCR (defaults below), run by the digests in release.env. The deploy job
# (deploy/remote.sh) writes IBERGRID_APP_DIGEST, IBERGRID_ORCHESTRATION_DIGEST and
# IBERGRID_API_DIGEST (sha256:<64 hex>) to release.env on every release; do not set them here.
#IBERGRID_IMAGE=ghcr.io/jaisato/ibergrid-lakehouse
#IBERGRID_ORCHESTRATION_IMAGE=ghcr.io/jaisato/ibergrid-lakehouse-orchestration
#IBERGRID_API_IMAGE=ghcr.io/jaisato/ibergrid-lakehouse-api
# Public domain served by Caddy (deploy/Caddyfile) when COMPOSE_PROFILES=edge is enabled.
#IBERGRID_DOMAIN=ibergrid-lakehouse.jasato.com
# Uncomment on a server with public DNS pointing to it to start Caddy (ports 80/443):
#COMPOSE_PROFILES=edge
